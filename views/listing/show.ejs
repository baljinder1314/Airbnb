<% layout('/layouts/boilerplate') %>

<body>
  <div class="row mt-3">
    <div class="col-8 offset-md-3 offset-2">
      <h2><b> <%=listing?.title%></b></h2>
    </div>
    <div class="card col-8 col-md-6 offset-2 offset-md-3">
      <img
        src="<%=listing.image%>"
        class="card-img-top show-image"
        alt="listing_image"
      />
      <div class="card-body">
        <p>Ownerd by <%=listing?.owner?.username%></p>
        <p class="card-text">
          <%=listing?.description%>   </p>
         <p> &#8377; <%=listing?.price?.toLocaleString('en-IN')%>
          </p>
          <p>  <%=listing?.location%> </p>
         <p> <%=listing?.country%></p>     
      </div>
    </div>
  </div>

  <%if(currUser && currUser?._id?.equals(listing?.owner?._id)){%>
  <div class="offset-2 offset-md-3 show-btns">
    <a class="btn" href="/listings/<%=listing._id%>/edit">Edit</a>
    <form action="/listings/<%=listing._id%>?_method=DELETE" method="post">
      <button class="btn">Delete</button>
    </form>
  </div>
  <%}%>

  <div class="mt-3 col-8 offset-md-3 offset-2">
    <%if(currUser){%>
    <h3>Leave a Review</h3>
    <form
      action="/listings/<%= listing._id%>/review"
      method="post"
      novalidate
      class="needs-validation"
    >
      <div class="">

        <fieldset class="starability-slot">
        <legend> Rating:</legend>
          <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
          <input type="radio" id="first-rate1" name="review[rating]" value="1" />
          <label for="first-rate1" title="Terrible">1 star</label>
          <input type="radio" id="first-rate2" name="review[rating]" value="2" />
          <label for="first-rate2" title="Not good">2 stars</label>
          <input type="radio" id="first-rate3" name="review[rating]" value="3" />
          <label for="first-rate3" title="Average">3 stars</label>
          <input type="radio" id="first-rate4" name="review[rating]" value="4" />
          <label for="first-rate4" title="Very good">4 stars</label>
          <input type="radio" id="first-rate5" name="review[rating]" value="5" />
          <label for="first-rate5" title="Amazing">5 stars</label>
      </fieldset>

      </div>


      <div class="mb-3">
        <label for="comment" class="form-label">Comment</label>
        <textarea
          required
          type="text"
          class="form-control"
          name="review[comment]"
          id="comment"
        ></textarea>
        <div class="invalid-feedback">Please Add Some Comments for review</div>
      </div>
      <div class="">
        <button class="btn">Submit</button>
      </div>


    </form>
    <%}%>
    <hr />

    <div class="">
      <h3>All Reviews</h3>
      <div class="row">
        <% for(let review of listing.reviews){ %>
        <div class="card mb-2 ms-1 col-12 col-md-5 border">
          <div class="card-body">
            <h5 class="card-title"><%= review?.author?.username%></h5>
            <p class="card-text"><%= review.comment %></p>
              <p class="starability-result" data-rating=<%= review.rating %>>
  </p>
            <form action="/listings/<%= listing._id%>/review/<%= review.id%>?_method=DELETE" method="post">
              <button class="btn btn-sm mb-3">Delete</button>
            </form>
          </div>

        </div>
          <%}%>
  </div>
</body>
